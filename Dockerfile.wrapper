FROM golang:1.27-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/grafana-mcp-wrapper ./cmd/grafana-mcp-wrapper

FROM alpine:3.20
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /app
COPY --from=builder /app/grafana-mcp-wrapper /app/grafana-mcp-wrapper

USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["/app/grafana-mcp-wrapper"]
